{
  "name": "kern-mcp-security",
  "displayName": "MCP Security Scanner — OWASP Rules for MCP Servers",
  "description": "Static analysis security scanner for MCP (Model Context Protocol) servers. 13 rules mapped to OWASP MCP Top 10. Detects command injection, path traversal, missing auth, secrets exposure, prompt injection. TypeScript + Python. CLI + GitHub Action + VS Code sidebar.",
  "version": "1.0.0",
  "publisher": "KERNlang",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KERNlang/kern-sight-mcp"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "security",
    "scanner",
    "linter",
    "static analysis",
    "prompt injection",
    "owasp",
    "claude",
    "cursor",
    "ai security",
    "vulnerability"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:python",
    "onView:kernMcpSecurity.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kernMcpSecurity",
          "title": "KERN MCP Security",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "kernMcpSecurity": [
        {
          "type": "webview",
          "id": "kernMcpSecurity.sidebar",
          "name": "MCP Security"
        }
      ]
    },
    "commands": [
      {
        "command": "kernMcpSecurity.scanFile",
        "title": "KERN: Scan MCP Server",
        "icon": "$(search)"
      },
      {
        "command": "kernMcpSecurity.showOutput",
        "title": "KERN: Show MCP Security Output"
      },
      {
        "command": "kernMcpSecurity.openSettings",
        "title": "KERN: MCP Security Settings",
        "icon": "$(gear)"
      },
      {
        "command": "kernMcpSecurity.generateBadge",
        "title": "KERN: Generate MCP Security Badge"
      }
    ],
    "keybindings": [
      {
        "command": "kernMcpSecurity.scanFile",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kernMcpSecurity.openSettings",
          "group": "navigation",
          "when": "view == kernMcpSecurity.sidebar"
        }
      ],
      "editor/title": [
        {
          "command": "kernMcpSecurity.scanFile",
          "group": "navigation",
          "when": "resourceLangId == typescript || resourceLangId == javascript || resourceLangId == python"
        }
      ],
      "editor/context": [
        {
          "command": "kernMcpSecurity.scanFile",
          "group": "kern",
          "when": "resourceLangId == typescript || resourceLangId == javascript || resourceLangId == python"
        }
      ]
    },
    "configuration": {
      "title": "KERN MCP Security",
      "properties": {
        "kernMcpSecurity.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable KERN MCP Security diagnostics"
        },
        "kernMcpSecurity.severity": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "errors",
            "warnings"
          ],
          "description": "Minimum severity level to show"
        },
        "kernMcpSecurity.animations": {
          "type": "boolean",
          "default": true,
          "description": "Enable sidebar animations (flow rail, pulse dots, transitions). Disable for a static UI."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "echo 'Tests moved to @kernlang/review-mcp'",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@kernlang/review-mcp": "^3.1.5"
  }
}
