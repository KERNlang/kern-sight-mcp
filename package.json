{
  "name": "kern-mcp-security",
  "displayName": "KERN MCP — Build, Review & Secure MCP Servers",
  "description": "Write .kern, compile to secure MCP servers (TypeScript + Python), auto-review with 13 OWASP MCP rules. Inline diagnostics, security scoring, quick fixes. Command injection, path traversal, missing auth, secrets exposure, prompt injection detection. Build + scan in one tool.",
  "version": "1.1.0",
  "publisher": "KERNlang",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KERNlang/kern-sight-mcp"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "mcp server",
    "mcp security",
    "mcp build",
    "mcp compiler",
    "mcp scanner",
    "mcp lint",
    "mcp linter",
    "kern",
    "security",
    "scanner",
    "linter",
    "static analysis",
    "compiler",
    "code generator",
    "build",
    "owasp",
    "prompt injection",
    "ai security",
    "claude",
    "cursor",
    "windsurf",
    "copilot",
    "ai tools",
    "vulnerability"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:python",
    "onLanguage:kern",
    "onView:kernMcpSecurity.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kernMcpSecurity",
          "title": "KERN MCP Security",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "kernMcpSecurity": [
        {
          "type": "webview",
          "id": "kernMcpSecurity.sidebar",
          "name": "MCP Security"
        }
      ]
    },
    "commands": [
      {
        "command": "kernMcpSecurity.scanFile",
        "title": "KERN: Scan MCP Server",
        "icon": "$(search)"
      },
      {
        "command": "kernMcpSecurity.showOutput",
        "title": "KERN: Show MCP Security Output"
      },
      {
        "command": "kernMcpSecurity.openSettings",
        "title": "KERN: MCP Security Settings",
        "icon": "$(gear)"
      },
      {
        "command": "kernMcpSecurity.generateBadge",
        "title": "KERN: Generate MCP Security Badge"
      },
      {
        "command": "kernMcpSecurity.compileMCP",
        "title": "KERN: Compile .kern to MCP Server"
      },
      {
        "command": "kernMcpSecurity.compileMCPPython",
        "title": "KERN: Compile .kern to MCP Server (Python)"
      },
      {
        "command": "kernMcpSecurity.validateKern",
        "title": "KERN: Validate .kern Syntax"
      },
      {
        "command": "kernMcpSecurity.generateMCP",
        "title": "KERN: Generate MCP Server with AI (Beta)"
      },
      {
        "command": "kernMcpSecurity.importToKern",
        "title": "KERN: Import MCP Server to .kern (Beta)"
      },
      {
        "command": "kernMcpSecurity.convertTarget",
        "title": "KERN: Convert MCP Server (TS ↔ Python) (Beta)"
      },
      {
        "command": "kernMcpSecurity.newKernFromTemplate",
        "title": "KERN: New .kern from Template"
      },
      {
        "command": "kernMcpSecurity.generateSecurityTests",
        "title": "KERN: Generate Security Test Scaffold from .kern"
      }
    ],
    "keybindings": [
      {
        "command": "kernMcpSecurity.scanFile",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus"
      }
    ],
    "languages": [
      {
        "id": "kern",
        "extensions": [
          ".kern"
        ],
        "aliases": [
          "KERN",
          "kern"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kern",
        "scopeName": "source.kern",
        "path": "./syntaxes/kern.tmLanguage.json"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kernMcpSecurity.openSettings",
          "group": "navigation",
          "when": "view == kernMcpSecurity.sidebar"
        }
      ],
      "editor/title": [
        {
          "command": "kernMcpSecurity.scanFile",
          "group": "navigation",
          "when": "resourceLangId == typescript || resourceLangId == javascript || resourceLangId == python"
        },
        {
          "command": "kernMcpSecurity.compileMCP",
          "group": "navigation",
          "when": "resourceLangId == kern"
        }
      ],
      "editor/context": [
        {
          "command": "kernMcpSecurity.scanFile",
          "group": "kern",
          "when": "resourceLangId == typescript || resourceLangId == javascript || resourceLangId == python"
        },
        {
          "command": "kernMcpSecurity.compileMCP",
          "group": "kern@1",
          "when": "resourceLangId == kern"
        },
        {
          "command": "kernMcpSecurity.compileMCPPython",
          "group": "kern@2",
          "when": "resourceLangId == kern"
        },
        {
          "command": "kernMcpSecurity.validateKern",
          "group": "kern@3",
          "when": "resourceLangId == kern"
        },
        {
          "command": "kernMcpSecurity.importToKern",
          "group": "kern@4",
          "when": "resourceLangId == typescript || resourceLangId == javascript || resourceLangId == python"
        },
        {
          "command": "kernMcpSecurity.convertTarget",
          "group": "kern@5",
          "when": "resourceLangId == typescript || resourceLangId == javascript || resourceLangId == python"
        },
        {
          "command": "kernMcpSecurity.generateSecurityTests",
          "group": "kern@4",
          "when": "resourceLangId == kern"
        },
        {
          "command": "kernMcpSecurity.newKernFromTemplate",
          "group": "kern@5",
          "when": "resourceLangId == kern"
        }
      ]
    },
    "configuration": {
      "title": "KERN MCP Security",
      "properties": {
        "kernMcpSecurity.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable KERN MCP Security diagnostics"
        },
        "kernMcpSecurity.severity": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "errors",
            "warnings"
          ],
          "description": "Minimum severity level to show"
        },
        "kernMcpSecurity.animations": {
          "type": "boolean",
          "default": true,
          "description": "Enable sidebar animations (flow rail, pulse dots, transitions). Disable for a static UI."
        },
        "kernMcpSecurity.ai.provider": {
          "type": "string",
          "default": "openai",
          "enum": [
            "openai",
            "anthropic",
            "gemini",
            "custom"
          ],
          "enumDescriptions": [
            "OpenAI (GPT-4o, GPT-4, etc.) — also works with DeepSeek, Qwen, Mistral, Ollama, LM Studio",
            "Anthropic (Claude Opus, Sonnet, Haiku)",
            "Google (Gemini Pro, Flash)",
            "Custom OpenAI-compatible endpoint"
          ],
          "description": "LLM provider for AI-assisted authoring (Generate, Import, Convert)"
        },
        "kernMcpSecurity.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the selected LLM provider"
        },
        "kernMcpSecurity.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model ID — only for API mode or Ollama (e.g. gpt-4.1, claude-sonnet-4-6, gemini-2.5-flash, deepseek-chat, llama3.1). CLI engines use their own configured model."
        },
        "kernMcpSecurity.ai.endpoint": {
          "type": "string",
          "default": "",
          "description": "Custom API endpoint URL. For DeepSeek: https://api.deepseek.com/v1/chat/completions, Ollama: http://localhost:11434/v1/chat/completions"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@kernlang/core": "file:../kern-lang/packages/core",
    "@kernlang/mcp": "file:../kern-lang/packages/mcp",
    "@kernlang/review-mcp": "file:../kern-lang/packages/review-mcp"
  }
}
