mcp name=FileServer version=1.0

  tool name=read_file
    description text="Read a file from the allowed directory"
    param name=path type=string required=true
    guard type=pathContainment param=path baseDir="./data"
    guard type=sanitize param=path
    handler <<<
      const fs = require('fs/promises');
      const content = await fs.readFile(args.path, 'utf-8');
      return { content: [{ type: "text", text: content }] };
    >>>

  tool name=write_file
    description text="Write content to a file in the allowed directory"
    param name=path type=string required=true
    param name=content type=string required=true
    guard type=pathContainment param=path baseDir="./data"
    guard type=sanitize param=path
    guard type=sizeLimit param=content maxBytes=1048576
    handler <<<
      const fs = require('fs/promises');
      await fs.writeFile(args.path, args.content, 'utf-8');
      return { content: [{ type: "text", text: `Written to ${args.path}` }] };
    >>>

  tool name=list_files
    description text="List files in a directory"
    param name=dir type=string default="."
    guard type=pathContainment param=dir baseDir="./data"
    guard type=sanitize param=dir
    handler <<<
      const fs = require('fs/promises');
      const entries = await fs.readdir(args.dir, { withFileTypes: true });
      const list = entries.map(e => ({ name: e.name, type: e.isDirectory() ? 'dir' : 'file' }));
      return { content: [{ type: "text", text: JSON.stringify(list) }] };
    >>>
